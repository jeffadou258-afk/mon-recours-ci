# Interface web Mon Recours CI — variables SERVEUR uniquement.
# Aucune de ces variables ne doit commencer par NEXT_PUBLIC_ : elles ne doivent
# jamais être envoyées au navigateur. Copier ce fichier en .env.local et remplir.

# URL du serveur local du moteur (bin/serveur_api.py). Il écoute sur 127.0.0.1
# uniquement : l'interface Next.js doit donc tourner sur la même machine.
MONRECOURS_API_URL=http://127.0.0.1:8765

# Même valeur que celle donnée au moteur (MONRECOURS_API_KEY, 16 caractères min.).
MONRECOURS_API_KEY=

# Secret de signature du cookie de session (32 caractères minimum, aléatoire).
# Exemple de génération : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MONRECOURS_SESSION_SECRET=

# Délai maximal d'attente d'une réponse du moteur, en millisecondes (optionnel).
MONRECOURS_API_TIMEOUT_MS=15000
