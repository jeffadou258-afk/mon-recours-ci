# Interface web Mon Recours CI — variables SERVEUR uniquement.
# Aucune de ces variables ne doit commencer par NEXT_PUBLIC_ : elles ne doivent
# jamais être envoyées au navigateur. Copier ce fichier en .env.local et remplir.

# URL du serveur local du moteur (bin/serveur_api.py). Il écoute sur 127.0.0.1
# uniquement : l'interface Next.js doit donc tourner sur la même machine.
MONRECOURS_API_URL=http://127.0.0.1:8765

# Même valeur que celle donnée au moteur (MONRECOURS_API_KEY, 16 caractères min.).
MONRECOURS_API_KEY=

# Secret de signature du cookie de session (32 caractères minimum, aléatoire).
# Exemple de génération : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MONRECOURS_SESSION_SECRET=

# Délai maximal d'attente d'une réponse du moteur, en millisecondes (optionnel).
MONRECOURS_API_TIMEOUT_MS=15000

# Demandes autorisées par visiteur et par minute (ouvrir + répondre). Optionnel.
MONRECOURS_DEBIT_VISITEUR=12

# --- Espace d'administration (FACULTATIF, fermé par défaut) -----------------
# Sans comptes valides, /connexion n'accepte aucune connexion et /admin est fermé.
# Toujours fermé en démonstration (MONRECOURS_MODE=demo).
# Comptes : UNE SEULE des deux sources ci-dessous. Si les deux sont définies,
# l'administration reste fermée (configuration ambiguë, aucune priorité implicite).
# Chaque entrée est produite par :
#   node scripts/creer-compte.mjs <adresse e-mail> [administrateur|lecteur]
# Le champ motDePasse contient une EMPREINTE scrypt, jamais un mot de passe en clair.
#
# 1) Recommandé : fichier JSON (tableau d'entrées), chemin ABSOLU, fichier ordinaire
#    (pas de lien symbolique), propriétaire = utilisateur du service, droits 0600
#    ou 0400, 64 Kio max. Relu à chaque requête.
# MONRECOURS_COMPTES_FICHIER=/etc/mon-recours-ci/comptes.json
# 2) Compatibilité : le même tableau JSON sur UNE ligne.
# MONRECOURS_COMPTES=[{"email":"…","role":"administrateur","motDePasse":"scrypt$16384$8$1$…$…"}]

# Fichier d'audit JSON Lines (chemin ABSOLU, facultatif). Sans lui, le journal
# d'audit n'est écrit que sur la sortie du serveur et /admin affiche « Non connecté ».
# MONRECOURS_AUDIT_FICHIER=/var/lib/monrecours/audit.jsonl
