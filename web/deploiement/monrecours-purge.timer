# Purge des consultations expirées, toutes les 15 minutes (NON installé).
# Politique (décision produit du 22/10/2026) : une consultation est conservée
# 24 heures au plus après sa création. Avec un passage tous les quarts d'heure,
# un dossier expiré disparaît du disque au plus 15 minutes après son échéance ;
# entre-temps, le moteur et l'interface refusent déjà de le servir.
#
# Installation — SEULEMENT après accord explicite du propriétaire : au premier
# passage, tous les dossiers web existants de plus de 24 h seront supprimés.
#   sudo cp monrecours-purge.service monrecours-purge.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now monrecours-purge.timer
#
# La purge ne touche pas aux archives : en production, les consultations sont
# exclues des sauvegardes (monrecours-sauvegarde.service, --sans-dossiers).

[Unit]
Description=Purge des consultations expirées (Mon Recours CI)

[Timer]
OnBootSec=2min
OnUnitActiveSec=15min
AccuracySec=1min
Persistent=true

[Install]
WantedBy=timers.target
