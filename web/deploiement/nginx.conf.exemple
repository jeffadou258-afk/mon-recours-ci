# /etc/nginx/sites-available/mon-recours-ci — remplacer votre-domaine.ci.
# certbot --nginx ajoutera ensuite les directives TLS (ssl_certificate…).

limit_req_zone $binary_remote_addr zone=monrecours_api:10m rate=20r/m;

server {
    listen 80;
    server_name votre-domaine.ci;

    client_max_body_size 32k;
    # Corps des requêtes (récits) gardés en mémoire : jamais écrits dans les
    # fichiers temporaires de nginx sur le disque.
    client_body_buffer_size 32k;
    # Journal d'accès : adresse, chemin, statut — jamais le corps des requêtes.
    # Ubuntu le fait tourner chaque jour et en garde 14 (/etc/logrotate.d/nginx).
    server_tokens off;

    location /api/ {
        limit_req zone=monrecours_api burst=10 nodelay;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        # Une seule valeur, fixée par nginx : l'interface lit la DERNIÈRE.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }
}
