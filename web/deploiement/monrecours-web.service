[Unit]
Description=Mon Recours CI — interface web Next.js
After=network.target monrecours-moteur.service
Requires=monrecours-moteur.service

[Service]
User=monrecours
Group=monrecours
WorkingDirectory=/opt/mon-recours-ci/web
EnvironmentFile=/etc/mon-recours-ci/env
ExecStart=/usr/bin/npm start -- --hostname 127.0.0.1 --port 3000
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/mon-recours-ci/web/.next
PrivateTmp=true
# Journal d'audit de l'administration : systemd crée /var/lib/monrecours au
# démarrage, propriété de monrecours:monrecours, droits 0700, et l'ajoute aux
# chemins inscriptibles malgré ProtectSystem=strict. Le reste du système reste
# en lecture seule. Fichier visé : MONRECOURS_AUDIT_FICHIER=/var/lib/monrecours/audit.jsonl
StateDirectory=monrecours
StateDirectoryMode=0700
# Fichiers créés par le service (journal d'audit) lisibles par lui seul.
UMask=0077
# Le fichier de comptes (/etc/mon-recours-ci/comptes.json, 0600, monrecours)
# reste lisible en lecture seule sous ProtectSystem=strict : rien à ouvrir.

[Install]
WantedBy=multi-user.target
