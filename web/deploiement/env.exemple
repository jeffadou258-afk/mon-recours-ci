# /etc/mon-recours-ci/env — droits 600, propriétaire monrecours. Aucune valeur réelle ici.
# Partagé par le moteur et l'interface (systemd EnvironmentFile).

MONRECOURS_API_KEY=
MONRECOURS_API_URL=http://127.0.0.1:8765
MONRECOURS_SESSION_SECRET=
MONRECOURS_API_TIMEOUT_MS=15000
MONRECOURS_DEBIT_VISITEUR=12
NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1

# --- Modèle de langage (FACULTATIF, désactivé par défaut) --------------------
# Les TROIS lignes FOURNISSEUR, API_KEY et ACCORD_DONNEES sont nécessaires pour
# l'activer. ACCORD_DONNEES=oui signifie : le propriétaire accepte que les récits
# (coordonnées masquées) soient envoyés au fournisseur. Voir docs/COUCHE_LANGAGE.md.
# MONRECOURS_LLM_FOURNISSEUR=anthropic        # ou compatible_openai
# MONRECOURS_LLM_API_KEY=
# MONRECOURS_LLM_ACCORD_DONNEES=oui
# MONRECOURS_LLM_MODELE=claude-haiku-5-5      # obligatoire pour compatible_openai
# MONRECOURS_LLM_URL=                         # obligatoire pour compatible_openai

# --- Espace d'administration (FACULTATIF, fermé par défaut) -----------------
# Comptes : tableau JSON sur une ligne, entrées produites par
#   node web/scripts/creer-compte.mjs <adresse e-mail> [administrateur|lecteur]
# MONRECOURS_COMPTES=[{"email":"…","role":"administrateur","motDePasse":"scrypt$…"}]
# Journal d'audit persistant (chemin absolu, fichier en 0600) :
# MONRECOURS_AUDIT_FICHIER=/var/lib/monrecours/audit.jsonl
