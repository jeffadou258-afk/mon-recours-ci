[Unit]
Description=Mon Recours CI — moteur juridique (local uniquement)
After=network.target

[Service]
User=monrecours
Group=monrecours
WorkingDirectory=/opt/mon-recours-ci
EnvironmentFile=/etc/mon-recours-ci/env
# Débit global du moteur : la limite par visiteur est appliquée par l'interface.
# Environnement virtuel : Ubuntu 24.04 interdit `pip install` dans le Python du
# système (PEP 668), et fpdf2 est nécessaire aux courriers PDF. Création :
#   python3 -m venv /opt/mon-recours-ci/.venv
#   /opt/mon-recours-ci/.venv/bin/pip install -r /opt/mon-recours-ci/requirements.txt
ExecStart=/opt/mon-recours-ci/.venv/bin/python bin/serveur_api.py --port 8765 --debit 300
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
# RUNTIME : état de l'incident « crédits épuisés », registre du plafond de jetons
# et verrou de la vérification de solde. Sans cette ligne, ProtectSystem=strict
# rend ce dossier en lecture seule : l'incident n'était jamais enregistré et le
# bouton de réactivation répondait « déjà en cours » indéfiniment. Le dossier
# doit exister (maj.sh le crée) : systemd refuse de démarrer sinon.
ReadWritePaths=/opt/mon-recours-ci/DOSSIERS /opt/mon-recours-ci/RUNTIME
PrivateTmp=true
ProtectHome=true
# Récits et courriers créés lisibles par le seul service.
UMask=0077

[Install]
WantedBy=multi-user.target
