# Purge quotidienne des consultations web expirées — Mon Recours CI.
#
# Compagnon de monrecours-purge.timer (qui déclenchait un service inexistant).
# Durée de conservation : 90 jours — HYPOTHÈSE DE CONCEPTION, à faire valider
# juridiquement avant toute utilisation réelle. Modifier --jours ici ET dans la
# page « comprendre » présentée aux utilisateurs.
#
# La sortie ne contient que des compteurs : aucune donnée personnelle n'entre
# dans le journal systemd. Le journal applicatif (JSONL) ne contient lui aussi
# que des compteurs — voir web/scripts/purger-consultations.mjs.

[Unit]
Description=Purge des consultations web expirées (Mon Recours CI)
Documentation=file:/opt/mon-recours-ci/docs/SAUVEGARDE_RESTAURATION.md
After=network.target

[Service]
Type=oneshot
User=monrecours
Group=monrecours
WorkingDirectory=/opt/mon-recours-ci/web
Environment=MONRECOURS_DOSSIERS=/opt/mon-recours-ci/DOSSIERS
Environment=MONRECOURS_JOURNAL_PURGE=/opt/mon-recours-ci/KNOWLEDGE/qualite/purge.jsonl
ExecStart=/usr/bin/node scripts/purger-consultations.mjs --jours 90 --confirmer

# Durcissement : aucun privilège, pas de /tmp partagé, système en lecture seule
# sauf les deux chemins que la purge doit écrire. SANS ReadWritePaths, la purge
# échouerait en EROFS : c'est la seule ouverture, et elle est nominative.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/mon-recours-ci/DOSSIERS /opt/mon-recours-ci/KNOWLEDGE/qualite

[Install]
WantedBy=multi-user.target
